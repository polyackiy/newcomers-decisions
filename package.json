{
  "name": "newcomers-decisions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyze:demo": "tsx --env-file=.env.local scripts/analyze-demo.ts",
    "format": "prettier --write app lib tests scripts \"*.ts\" \"*.json\"",
    "format:check": "prettier --check app lib tests scripts \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "openai": "7.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
